{
  "productName": "Hang Wonder Union",
  "version": "0.1.5",
  "identifier": "com.hangwu.desktop",
  "build": {
    "beforeDevCommand": "npm run dev:vite",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build:vite",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Hằng Wonder Union",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 640,
        "maximized": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "resources": {
      "migrations/*": "migrations/"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "active": true,
      "dialog": false,
      "endpoints": [
        "https://github.com/huuyen911/hang-wu-desktop/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQzNEJGNTQ5RjUyNUFCMTEKUldRUnF5WDFTZlZMUTFRaG8vSEEyV2UwMTBzaW5nbnc0OFFQN3JEc3lDeWRmNTF3ZXlWK0hhN1gK"
    }
  }
}
